# Public hostname pointing at this VPS (A record). No domain? Use e.g. 187-77-1-23.sslip.io
DOMAIN=mp.example.com

# The VPS's public IPv4. WebRTC advertises it to browsers (inside Docker the server only sees its container IP).
# deploy.sh fills it in. Without it browsers can't open the WebRTC link and stay on WebSocket.
PUBLIC_IP=

# Dashboard / admin API token. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional tuning
# OPEN_GAMES=false            # true = any unknown key auto-creates a game (dev only)
# RATE_LIMIT=60               # sustained msgs/sec per connection
# RATE_BURST=200
# MAX_MSG_BYTES=65536
# RECONNECT_GRACE_MS=15000    # how long a dropped player keeps their room slot
# MAX_ROOM_PLAYERS=256
# MAX_CONNS_PER_IP=50
# Transports (clients start on WebSocket, measure every link and move to the fastest):
# UDP_PORT=8081               # raw UDP for native/Node clients; 0 = off. Also change the port mapping in docker-compose.yml
# RTC_PORT=8082               # WebRTC data channels, all peers multiplexed on this one UDP port
# WEBRTC=false                # turn WebRTC off
# UDP_HOST=                   # host clients send raw UDP to (default: the host they connected to; set it when behind Cloudflare)
# ICE_SERVERS=stun:stun.l.google.com:19302   # comma-separated, rarely needed on a public server
