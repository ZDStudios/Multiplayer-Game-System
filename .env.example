# Public hostname pointing at this VPS (A record). No domain? Use e.g. 187-77-1-23.sslip.io
DOMAIN=mp.example.com

# Dashboard / admin API token. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional tuning
# OPEN_GAMES=false            # true = any unknown key auto-creates a game (dev only)
# RATE_LIMIT=60               # sustained msgs/sec per connection
# RATE_BURST=200
# MAX_MSG_BYTES=65536
# RECONNECT_GRACE_MS=15000    # how long a dropped player keeps their room slot
# MAX_ROOM_PLAYERS=256
# MAX_CONNS_PER_IP=50
